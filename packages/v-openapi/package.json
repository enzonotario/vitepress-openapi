{
  "name": "v-openapi",
  "type": "module",
  "version": "0.2.18",
  "description": "Vue 3 components to render OpenAPI documents, with a playground and code samples.",
  "author": "Enzo Notario <hi@enzonotario.me>",
  "license": "MIT",
  "homepage": "https://vitepress-openapi.vercel.app/standalone/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enzonotario/vitepress-openapi.git",
    "directory": "packages/v-openapi"
  },
  "keywords": [
    "vue",
    "openapi",
    "swagger",
    "api-documentation"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./style.css": "./style.css",
    "./standalone.css": "./standalone.css"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "standalone.css",
    "style.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "vitepress-openapi": "workspace:*"
  }
}
