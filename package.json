{
  "name": "vitepress-openapi",
  "type": "module",
  "version": "0.2.20",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "homepage": "https://vitepress-openapi.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enzonotario/vitepress-openapi.git"
  },
  "author": "Enzo Notario <hi@enzonotario.me>",
  "license": "MIT",
  "keywords": [
    "vitepress",
    "vitepress-theme",
    "vitepress-plugin",
    "openapi"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/vitepress-openapi.node.es.js"
    },
    "./client": {
      "types": "./dist/types/src/client.d.ts",
      "import": "./dist/vitepress-openapi.client.es.js"
    },
    "./vue": {
      "types": "./dist/types/src/vue.d.ts",
      "import": "./dist/vitepress-openapi.vue.es.js"
    },
    "./dist/style.css": "./dist/vitepress-openapi.css",
    "./dist/standalone.css": "./dist/standalone.css"
  },
  "main": "./dist/vitepress-openapi.node.es.js",
  "module": "./dist/vitepress-openapi.node.es.js",
  "types": "./dist/types/src/index.d.ts",
  "bin": {
    "vitepress-openapi": "./dist/vitepress-openapi.cli.es.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "build-watch": "vite build --watch",
    "postbuild": "vue-tsc --emitDeclarationOnly && node scripts/build-standalone-css.mjs",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint src .github/workflows",
    "lint:fix": "eslint src .github/workflows --fix",
    "dev": "cd docs && VITE_DEBUG=1 pnpm run dev",
    "dev:standalone": "cd e2e/local/standalone && vite --mode source --port 4175",
    "docs:build": "pnpm run build && cd docs && pnpm run build",
    "test": "vitest",
    "test:run": "vitest --run",
    "typecheck": "vue-tsc --noEmit",
    "e2e:local:dev": "cd e2e/local/dev && vitepress dev docs --port 4173",
    "e2e:local:standalone": "cd e2e/local/standalone && vite --port 4174 --strictPort",
    "e2e:local:test": "playwright test local",
    "e2e:update-snapshots": "node scripts/update-snapshots.js",
    "e2e:staging:test": "playwright test staging",
    "test:packed": "pnpm build && node scripts/test-packed.mjs"
  },
  "peerDependencies": {
    "vitepress": ">=1.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "dependencies": {
    "@lucide/vue": "^1.80.0",
    "@vueuse/core": "^15.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it-link-attributes": "^4.0.1",
    "reka-ui": "^2.11.0",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@scalar/openapi-types": "^0.9.10",
    "@scalar/snippetz": "^0.10.23",
    "@scalar/types": "^0.32.1",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@sindresorhus/slugify": "^4.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@trojs/openapi-dereference": "^2.0.4",
    "@tszen/trycatch": "^0.1.0",
    "@types/har-format": "^1.2.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.10",
    "@vitejs/plugin-vue": "^6.0.11",
    "allof-merge": "^1.1.0",
    "confbox": "^0.3.2",
    "destr": "^2.0.5",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.2.0",
    "eslint-plugin-format": "^2.0.1",
    "js-yaml": "^5.5.0",
    "json-editor-vue": "^0.19.2",
    "json-xml-parse": "^1.3.0",
    "markdown-it": "^15.0.3",
    "postcss": "^8.5.33",
    "scule": "^1.3.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-json-pretty": "^2.6.0",
    "vue-tsc": "^3.3.14"
  }
}
