{
  "openapi": "3.0.0",
  "info": {
    "title": "Example of an OpenAPI document with security",
    "version": "1.0.0",
    "description": "OpenAPI security examples backed by [httpbin.io](https://httpbin.io/) so the playground returns real responses (headers, bearer auth, cookies, request body echo).\n\nUse **Get token** on bearer-protected operations to open the auth playground (`POST /auth/login` against [dummyjson](https://dummyjson.com)). Demo credentials: `emilys` / `emilyspass`."
  },
  "servers": [
    {
      "url": "https://httpbin.io",
      "description": "httpbin.io — HTTP request & response testing service"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "getToken",
        "summary": "Obtain access token",
        "description": "Demo login used by the auth playground modal. Calls [dummyjson `/auth/login`](https://dummyjson.com/docs/auth) (operation-level server). Try username `emilys` and password `emilyspass`. The response includes `accessToken`, which is written into the `bearerAuth` playground field.",
        "security": [],
        "servers": [
          {
            "url": "https://dummyjson.com",
            "description": "dummyjson auth demo"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "example": {
                "username": "emilys",
                "password": "emilyspass",
                "expiresInMins": 30
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated; includes access and refresh tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/anything/only-api-key": {
      "get": {
        "operationId": "onlyApiKey",
        "summary": "API key in header",
        "description": "Calls httpbin `/anything`, which echoes request headers so you can verify `api_key` was sent.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Echo of the request including headers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnythingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bearer": {
      "get": {
        "operationId": "onlyBearerAuth",
        "summary": "Bearer authentication",
        "description": "Calls httpbin `/bearer`, which requires a valid `Authorization: Bearer <token>` header and returns 401 without it. If the token field is empty, use **Get token** to authenticate via `POST /auth/login`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": {
                      "type": "boolean",
                      "example": true
                    },
                    "token": {
                      "type": "string",
                      "example": "your-token"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          }
        }
      }
    },
    "/put": {
      "put": {
        "operationId": "apiKeyAndBearerAuth",
        "summary": "API key and bearer auth",
        "description": "Calls httpbin `/put`, which echoes headers and JSON body. Requires both `api_key` and bearer auth.",
        "security": [
          {
            "apiKey": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "headerParam",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Header parameter description",
            "example": "value"
          }
        ],
        "responses": {
          "200": {
            "description": "Echo of the PUT request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnythingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/anything/{pathParam}": {
      "get": {
        "operationId": "apiKeyOrBearerAuth",
        "summary": "API key or bearer auth",
        "description": "Calls httpbin `/anything/{pathParam}`. Accepts either an API key or a bearer token.",
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pathParam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path segment echoed by httpbin",
            "example": "demo"
          }
        ],
        "responses": {
          "200": {
            "description": "Echo of the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnythingResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "multipleSecurity",
        "summary": "Multiple security requirement options",
        "description": "Calls httpbin `/anything/{pathParam}` with a JSON body. Either (apiKey + bearer) or (basicAuth + internalApiKey).",
        "security": [
          {
            "apiKey": [],
            "bearerAuth": []
          },
          {
            "basicAuth": [],
            "internalApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "param1",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "value1",
                "value2"
              ],
              "default": "value1"
            },
            "description": "Query parameter description"
          },
          {
            "name": "param2",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Another query parameter description",
            "example": "hello"
          },
          {
            "name": "pathParam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path segment echoed by httpbin",
            "example": "demo"
          }
        ],
        "requestBody": {
          "description": "Request body description",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prop1": {
                    "type": "string"
                  },
                  "prop2": {
                    "type": "number"
                  },
                  "prop3": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Array of strings",
                      "example": [
                        "value1",
                        "value2"
                      ]
                    }
                  }
                }
              },
              "example": {
                "prop1": "value1",
                "prop2": 42,
                "prop3": [
                  "value1",
                  "value2"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Echo of the request including body, args, and headers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnythingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/get": {
      "get": {
        "operationId": "noSecurity",
        "summary": "No security",
        "description": "Calls httpbin `/get` with no authentication required.",
        "security": [],
        "responses": {
          "200": {
            "description": "Echo of the GET request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/anything/api-key-query": {
      "get": {
        "operationId": "onlyApiKeyQuery",
        "summary": "API key in query",
        "description": "Calls httpbin `/anything`, which echoes query args so you can verify `api_key` was sent as a query parameter.",
        "security": [
          {
            "apiKeyQuery": []
          }
        ],
        "parameters": [
          {
            "name": "optionalParam",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "An optional query parameter",
            "example": "optional-value"
          }
        ],
        "responses": {
          "200": {
            "description": "Echo of the request including query args",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnythingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/headers": {
      "get": {
        "operationId": "listDownloads",
        "summary": "apiKey header name differs from scheme key",
        "description": "Uses `managementKey` as the securitySchemes key but sends the header `X-Management-Key`. Code samples must use the scheme `name`, not the key. Calls httpbin `/headers` so the response shows the received headers.",
        "security": [
          {
            "managementKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Request headers as seen by httpbin",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "headers": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cookies": {
      "get": {
        "operationId": "torrentInfo",
        "summary": "apiKey in cookie",
        "description": "Uses an apiKey scheme with `in: cookie`. Code samples must send a `Cookie` request header, not `Set-Cookie`. Calls httpbin `/cookies`, which returns cookies received on the request.",
        "security": [
          {
            "sid": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cookies received by httpbin",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "example": {
                    "SID": "session-id-example"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TokenRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "emilys"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "emilyspass"
          },
          "expiresInMins": {
            "type": "number",
            "example": 30
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token used as the bearer value"
          },
          "refreshToken": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "GetResponse": {
        "type": "object",
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": true
          },
          "headers": {
            "type": "object",
            "additionalProperties": true
          },
          "origin": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "AnythingResponse": {
        "type": "object",
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "additionalProperties": true
          },
          "form": {
            "type": "object",
            "additionalProperties": true
          },
          "headers": {
            "type": "object",
            "additionalProperties": true
          },
          "json": {
            "nullable": true
          },
          "method": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "api_key",
        "in": "header",
        "example": "your-api-key"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "api_key",
        "in": "query",
        "example": "your-api-key"
      },
      "managementKey": {
        "type": "apiKey",
        "name": "X-Management-Key",
        "in": "header",
        "description": "Management API key. Scheme key is `managementKey`; header name is `X-Management-Key`.",
        "example": "mgmt-secret"
      },
      "sid": {
        "type": "apiKey",
        "name": "SID",
        "in": "cookie",
        "description": "Session id cookie. Request samples must use the Cookie header.",
        "example": "session-id-example"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic authentication with username and password"
      },
      "internalApiKey": {
        "type": "apiKey",
        "name": "internal_api_key",
        "in": "header",
        "description": "Internal API key for special customers",
        "example": "special-key"
      }
    }
  }
}
