{
  "openapi": "3.0.0",
  "info": {
    "title": "Example of an OpenAPI document with security",
    "version": "1.0.0",
    "description": "This is an example of an OpenAPI document with security definitions and security requirements."
  },
  "servers": [
    {
      "url": "https://localhost:3000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/onlyApiKey": {
      "get": {
        "operationId": "onlyApiKey",
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
    "/onlyBearerAuth": {
      "post": {
        "operationId": "onlyBearerAuth",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/apiKeyAndBearerAuth": {
      "put": {
        "operationId": "apiKeyAndBearerAuth",
        "security": [
          {
            "apiKey": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "headerParam",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Header parameter description",
            "example": "value"
          }
        ]
      }
    },
    "/apiKeyOrBearerAuth/{pathParam}": {
      "get": {
        "operationId": "apiKeyOrBearerAuth",
        "security": [
          {
            "apiKey": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pathParam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path parameter description"
          }
        ]
      }
    },
    "/noSecurity": {
      "get": {
        "operationId": "noSecurity",
        "security": []
      }
    },
    "/multipleSecurity/{pathParam}": {
      "post": {
        "operationId": "multipleSecurity",
        "security": [
          {
            "apiKey": [],
            "bearerAuth": []
          },
          {
            "basicAuth": [],
            "internalApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "param1",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "value1",
                "value2"
              ],
              "default": "value1"
            },
            "description": "Query parameter description"
          },
          {
            "name": "param2",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Another query parameter description"
          },
          {
            "name": "pathParam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path parameter description"
          }
        ],
        "requestBody": {
          "description": "Request body description",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prop1": {
                    "type": "string"
                  },
                  "prop2": {
                    "type": "number"
                  },
                  "prop3": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Array of strings",
                      "example": [
                        "value1",
                        "value2"
                      ]
                    }
                  }
                }
              },
              "example": {
                "prop1": "value1"
              }
            }
          }
        }
      }
    },
    "/onlyApiKeyQuery": {
      "get": {
        "operationId": "onlyApiKeyQuery",
        "summary": "API key in query",
        "security": [
          {
            "apiKeyQuery": []
          }
        ],
        "parameters": [
          {
            "name": "optionalParam",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "An optional query parameter"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/downloads": {
      "get": {
        "operationId": "listDownloads",
        "summary": "apiKey header name differs from scheme key",
        "description": "Uses `managementKey` as the securitySchemes key but sends the header `X-Management-Key`. Code samples must use the scheme `name`, not the key.",
        "security": [
          {
            "managementKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of downloads"
          }
        }
      }
    },
    "/api/v2/torrents/info": {
      "get": {
        "operationId": "torrentInfo",
        "summary": "apiKey in cookie",
        "description": "Uses an apiKey scheme with `in: cookie`. Code samples must send a `Cookie` request header, not `Set-Cookie`.",
        "security": [
          {
            "sid": []
          }
        ],
        "responses": {
          "200": {
            "description": "Torrent info"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "api_key",
        "in": "header",
        "example": "your-api-key"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "api_key",
        "in": "query",
        "example": "your-api-key"
      },
      "managementKey": {
        "type": "apiKey",
        "name": "X-Management-Key",
        "in": "header",
        "description": "Management API key. Scheme key is `managementKey`; header name is `X-Management-Key`.",
        "example": "mgmt-secret"
      },
      "sid": {
        "type": "apiKey",
        "name": "SID",
        "in": "cookie",
        "description": "Session id cookie. Request samples must use the Cookie header.",
        "example": "session-id-example"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic authentication with username and password"
      },
      "internalApiKey": {
        "type": "apiKey",
        "name": "internal_api_key",
        "in": "header",
        "description": "Internal API key for special customers",
        "example": "special-key"
      }
    }
  }
}
